{
  "$schema": "../../../schemas/pages.schema.json",
  "title": "EdgePress website builder",
  "lang": "en",
  "slug": "home",
  "homepage": true,
  "description": "Build fast static websites with zero runtime dependencies using Markdown posts, JSON pages, and lightweight themes.",
  "keywords": [
    "static site generator",
    "zero dependencies",
    "Markdown",
    "Cloudflare Workers"
  ],
  "blocks": [
    {
      "columns": 1,
      "cells": [
        [
          {
            "type": "hero",
            "eyebrow": "Zero-dependency static site builder",
            "title": "Build a fast website from plain source files.",
            "text": "Write posts in Markdown, lay out pages in JSON, pick a built-in theme, and publish dist/ to Cloudflare, Vercel, Netlify, EdgeOne Pages, ESA Pages, or your own VPS.",
            "mascotSrc": "/edgepress/brand/home-hero.png",
            "mascotAlt": "A giant panda and Taiwanese black bear standing together with friendly smiles; the bear has a clear pale V chest marking.",
            "mascotWidth": 1536,
            "mascotHeight": 1024,
            "mascotSizes": "(max-width: 620px) calc(100vw - 64px), 320px",
            "mascotWebpSrcset": [
              {
                "src": "/edgepress/brand/home-hero-768.webp",
                "width": 768
              },
              {
                "src": "/edgepress/brand/home-hero.webp",
                "width": 1536
              }
            ],
            "cta": {
              "label": "Open the quick start",
              "url": "/quick-start/"
            },
            "highlights": [
              "Zero runtime npm dependencies on Node.js 22+",
              "Automatic font subsetting and minified static assets",
              "Built-in preview server and visual Pages editor"
            ]
          }
        ]
      ]
    },
    {
      "columns": 1,
      "cells": [
        [
          {
            "type": "feature-grid",
            "title": "How a site is organized",
            "items": [
              {
                "title": "Structured JSON pages",
                "icon": "layout-grid",
                "text": "Arrange 1 to 4 columns per row and place text, images, tables, or post lists inside each cell.",
                "url": "/page-authoring/"
              },
              {
                "title": "Plain Markdown posts",
                "icon": "file-text",
                "text": "Write articles in Markdown. EdgePress sanitizes HTML, builds feeds, and creates local search indexes.",
                "url": "/project-introduction/"
              },
              {
                "title": "Lightweight themes",
                "icon": "palette",
                "text": "Edit HTML partials and CSS tokens in themes/ without hunting through duplicate style overrides.",
                "url": "/theme-development/"
              },
              {
                "title": "Consent-gated services",
                "icon": "shield-check",
                "text": "Configure analytics, comments, or oEmbed providers in config.yml. The browser loads them only after a visitor agrees.",
                "url": "/plugin-development/"
              }
            ]
          }
        ]
      ]
    },
    {
      "columns": 2,
      "cells": [
        [
          {
            "type": "section",
            "title": "Get started",
            "tone": "soft",
            "blocks": [
              {
                "type": "text",
                "paragraphs": [
                  "Read the project overview and quick start to install EdgePress, create your first post, and deploy to a static host."
                ]
              },
              {
                "type": "link-list",
                "title": "Core guides",
                "items": [
                  {
                    "label": "Project introduction",
                    "url": "/project-introduction/"
                  },
                  {
                    "label": "Quick start",
                    "url": "/quick-start/"
                  }
                ]
              }
            ]
          }
        ],
        [
          {
            "type": "section",
            "title": "Customize your site",
            "tone": "soft",
            "blocks": [
              {
                "type": "text",
                "paragraphs": [
                  "Edit shared headers, footers, and CSS palettes inside your theme folder, and keep per-page blocks in content/pages/.",
                  "Write build-time plugins in Node.js and register optional browser integrations in config.yml."
                ]
              },
              {
                "type": "link-list",
                "title": "Developer guides",
                "items": [
                  {
                    "label": "Theme development",
                    "url": "/theme-development/"
                  },
                  {
                    "label": "Plugin development",
                    "url": "/plugin-development/"
                  }
                ]
              }
            ]
          }
        ]
      ]
    },
    {
      "columns": 1,
      "cells": [
        [
          {
            "type": "latest-posts",
            "title": "Latest posts",
            "count": 3,
            "paginate": true
          }
        ]
      ]
    },
    {
      "columns": 1,
      "cells": [
        [
          {
            "type": "media-text",
            "mediaType": "image",
            "src": "/images/previews/edgepress-en.webp",
            "alt": "Local EdgePress website preview.",
            "caption": "Generated static site preview.",
            "placement": "left",
            "title": "Preview changes immediately",
            "text": "Run edgepress s to start the built-in local server. Save a Markdown post or a JSON page, and the preview rebuilds right away."
          }
        ]
      ]
    },
    {
      "columns": 1,
      "cells": [
        [
          {
            "type": "data-table",
            "title": "Free hosting comparison (2026-10-04)",
            "headers": [
              "Priority",
              "Platform",
              "Allowance and conditions"
            ],
            "rows": [
              [
                "1",
                "Cloudflare",
                "Unlimited static requests; 3,000 build minutes/month."
              ],
              [
                "2",
                "Tencent EdgeOne Pages",
                "Currently unlimited website traffic/requests; 500 builds/month. Free-phase limits may change."
              ],
              [
                "3",
                "Vercel Hobby",
                "100 GB/month and 1 million CDN requests; personal non-commercial use."
              ],
              [
                "4",
                "Netlify Free",
                "300 shared credits/month. A deploy costs 15; traffic 20/GB; requests 2/10,000. Pauses when exhausted."
              ],
              [
                "Verify",
                "Alibaba Cloud ESA Pages",
                "Traffic uses the site package. Confirm its quota; 100,000/day functions is not static bandwidth."
              ]
            ]
          }
        ]
      ]
    },
    {
      "columns": 1,
      "cells": [
        [
          {
            "type": "link-list",
            "title": "Deployment references",
            "items": [
              {
                "label": "Chinese guide",
                "url": "https://github.com/jsw-teams/edgepress/blob/main/content/guides/zh-cn.md"
              },
              {
                "label": "Official quota sources",
                "url": "https://github.com/jsw-teams/edgepress/blob/main/content/guides/platforms.md"
              }
            ]
          }
        ]
      ]
    }
  ]
}
