{
  "name": "edgepress",
  "license": "MIT",
  "version": "2026.10.15",
  "description": "Static websites from Markdown and editable pages, with themes, consent-controlled embeds and readable article updates.",
  "type": "module",
  "bin": {
    "edgepress": "src/cli.js"
  },
  "files": [
    "content",
    "languages",
    "plugins",
    "src",
    "schemas",
    "static",
    "themes",
    "config.yml",
    "edgepress.config.mjs",
    "project-compatibility.json",
    "wrangler.jsonc",
    "README.md",
    "vercel.json",
    "edgeone.json",
    "esa.jsonc",
    "netlify.toml",
    "tests",
    "tools/assets",
    "tools/recordings",
    "tools/verification"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jsw-teams/edgepress.git"
  },
  "homepage": "https://github.com/jsw-teams/edgepress#readme",
  "keywords": [
    "static-site-generator",
    "cloudflare-workers",
    "markdown",
    "website-builder",
    "accessibility"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "new": "node src/cli.js new",
    "build": "node src/cli.js build",
    "generate": "node src/cli.js generate",
    "dev": "node src/cli.js server",
    "preview": "node src/cli.js server",
    "deploy": "node src/cli.js deploy",
    "clean": "node src/cli.js clean",
    "check": "node src/cli.js check",
    "doctor": "node src/cli.js doctor",
    "iterate": "node src/cli.js iterate",
    "security:check": "node src/cli.js security",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "icons:sync": "node tools/assets/sync-icons.mjs",
    "deploy:cloudflare": "node src/cli.js deploy cloudflare",
    "deploy:vercel": "node src/cli.js deploy vercel",
    "deploy:edgeone": "node src/cli.js deploy edgeone",
    "deploy:esa": "node src/cli.js deploy esa",
    "deploy:netlify": "node src/cli.js deploy netlify",
    "fonts:sync": "node tools/assets/sync-fonts.mjs",
    "editor": "node src/cli.js editor",
    "audit": "node tools/maintenance/audit-dependencies.mjs low",
    "deploy:local": "node src/cli.js server"
  },
  "dependencies": {
    "@jsw-teams/document-viewer": "git+https://github.com/jsw-teams/document-viewer.git#semver:^2026.10.1",
    "@jsw-teams/media-viewer": "git+https://github.com/jsw-teams/media-viewer.git#semver:^2026.10.1",
    "esbuild": "^0.28.2",
    "htmlparser2": "^12.0.0",
    "image-size": "^2.0.4",
    "marked": "^18.1.1",
    "postcss": "^8.5.31",
    "sanitize-html": "^2.18.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@file-viewer/doc": {
      "dompurify": "^3.4.17"
    },
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "lucide-static": "^1.61.0",
    "playwright": "^1.64.1",
    "vscode-json-languageservice": "^6.0.0-next.3",
    "wrangler": "^4.152.0"
  }
}
