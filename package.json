{
  "name": "edgepress",
  "version": "2.0.0",
  "description": "Zero-dependency, ultra-fast static site generator & high-freedom theme framework with B-End Design System default theme.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "bin": {
    "edgepress": "src/cli.js"
  },
  "scripts": {
    "dev": "node src/cli.js dev",
    "build": "node src/cli.js build",
    "serve": "node src/cli.js serve",
    "new": "node src/cli.js new",
    "theme": "node src/cli.js theme",
    "clean": "node src/cli.js clean",
    "doctor": "node src/cli.js doctor",
    "bench": "node src/cli.js bench",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {},
  "keywords": [
    "static-site-generator",
