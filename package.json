{
  "name": "edgepress",
  "version": "2026.10.5",
  "description": "A static website builder for Cloudflare Workers with editable pages, Markdown posts, local search, themes, and consent-gated integrations.",
  "type": "module",
  "bin": {
    "edgepress": "src/cli.js"
  },
  "files": [
    "content",
    "languages",
    "plugins",
    "src",
    "static",
    "themes",
    "config.yml",
    "edgepress.config.mjs",
    "project-compatibility.json",
    "wrangler.jsonc",
    "README.md",
    "tools/writing.test.mjs",
    "tools/brand-regression.test.mjs",
    "tools/post-list.test.mjs",
    "tools/audit.test.mjs",
    "tools/navigation.test.mjs",
    "tools/revisions.test.mjs",
    "tools/publication-time.test.mjs",
    "tools/consent-config.test.mjs",
    "tools/consent-browser.test.mjs",
    "vercel.json",
    "edgeone.json",
    "esa.jsonc",
    "tools/services.test.mjs",
    "netlify.toml",
    "tools/oembed.test.mjs",
    "tools/consent-csp.test.mjs",
    "tools/assets-runtime.test.mjs",
    "tools/theme-layout.test.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jsw-teams/edgepress.git"
  },
  "homepage": "https://github.com/jsw-teams/edgepress#readme",
  "keywords": [
    "static-site-generator",
    "cloudflare-workers",
    "markdown",
    "website-builder",
    "accessibility"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "new": "node src/cli.js new",
    "build": "node src/cli.js build",
    "generate": "node src/cli.js generate",
    "dev": "node src/cli.js server",
    "preview": "node src/cli.js server",
    "deploy": "node src/cli.js deploy",
    "clean": "node src/cli.js clean",
    "check": "node src/cli.js check",
    "doctor": "node src/cli.js doctor",
    "iterate": "node src/cli.js iterate",
    "security:check": "node src/cli.js security",
    "test": "node --test tools/writing.test.mjs tools/brand-regression.test.mjs tools/post-list.test.mjs tools/audit.test.mjs tools/navigation.test.mjs tools/revisions.test.mjs tools/publication-time.test.mjs tools/consent-config.test.mjs tools/consent-browser.test.mjs tools/services.test.mjs tools/oembed.test.mjs tools/consent-csp.test.mjs tools/assets-runtime.test.mjs tools/theme-layout.test.mjs",
    "icons:sync": "node tools/sync-icons.mjs",
    "deploy:cloudflare": "node src/cli.js deploy cloudflare",
    "deploy:vercel": "node src/cli.js deploy vercel",
    "deploy:edgeone": "node src/cli.js deploy edgeone",
    "deploy:esa": "node src/cli.js deploy esa",
    "deploy:netlify": "node src/cli.js deploy netlify"
  },
  "dependencies": {
    "marked": "^18.0.13",
    "sanitize-html": "^2.17.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.144.0",
    "lucide-static": "1.50.0"
  }
}
